# DrainQ.ONE ROM-Provisioning für Bominwell RK3588 Tablet
#
# Versteckt den schwarzen ScreenDecorOverlayBottom-Balken am unteren
# Display-Rand. Property sys.status.hidebar_enable=true allein reicht
# NICHT -- SystemUI muss zusaetzlich neu initialisiert werden, NACHDEM
# Settings.Secure.navigation_mode auf 0 gesetzt ist. ROM setzt es beim
# Boot wieder auf 2.
#
# Die Loesung: oneshot-Service der ein Shell-Script ausfuehrt nachdem
# sys.boot_completed=1 ist. Das Script macht settings put + killall
# com.android.systemui. SystemUI restartet automatisch.
#
# Diese Datei gehoert nach: /system/etc/init/init.drainq.rc
# Das Script gehoert nach:  /system/bin/drainq-postboot.sh
# Beide werden via adb push einmalig pro Tablet ins ROM provisioniert.

on early-boot
    setprop sys.status.hidebar_enable true

on boot
    setprop sys.status.hidebar_enable true

service drainq_postboot /system/bin/drainq-postboot.sh
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start drainq_postboot
