<!--
  Day/Night-Toggle fuer Bottom-Bar-Position 8 (KeyCode 137).
  Halb-gefuellter Kreis (linke Haelfte weiss = Tag, rechte Haelfte Outline = Nacht)
  im Stil der ONE.APP V1.3.0 — klassische Yin/Yang-Light/Dark-Symbolik.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- Outline-Kreis komplett -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 Z" />
    <!-- Linke Haelfte weiss gefuellt -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3 A9,9 0 0,0 12,21 L12,3 Z" />
</vector>
